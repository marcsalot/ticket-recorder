<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.theticket.monitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/marcus/ticket-recorder/monitor_health.py</string>
        <string>--output-dir</string>
        <string>/Users/marcus/Dropbox/TheTicket</string>
    </array>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>StandardOutPath</key>
    <string>/Users/marcus/ticket-recorder/logs/monitor.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/marcus/ticket-recorder/logs/monitor.error.log</string>
    <key>WorkingDirectory</key>
    <string>/Users/marcus/ticket-recorder</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
